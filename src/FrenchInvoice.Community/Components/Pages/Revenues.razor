@page "/revenues"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject ITenantProvider TenantProvider
@inject HashChainService HashChainService
@inject ClosingService ClosingService
@inject IDialogService DialogService

<PageTitle>Recettes — FrenchInvoice</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Recettes</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" sm="4" md="3">
            <MudDatePicker Label="Date début" @bind-Date="_filterDateStart" DateFormat="dd/MM/yyyy"
                           Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudDatePicker Label="Date fin" @bind-Date="_filterDateEnd" DateFormat="dd/MM/yyyy"
                           Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudSelect @bind-Value="_filterModePaiement" Label="Mode de paiement" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Clearable="true">
                <MudSelectItem Value="@("Virement")">Virement</MudSelectItem>
                <MudSelectItem Value="@("Chèque")">Chèque</MudSelectItem>
                <MudSelectItem Value="@("Espèces")">Espèces</MudSelectItem>
                <MudSelectItem Value="@("Carte bancaire")">Carte bancaire</MudSelectItem>
                <MudSelectItem Value="@("PayPal")">PayPal</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" md="3" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFilter"
                       StartIcon="@Icons.Material.Filled.FilterAlt">Filtrer</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_canEdit)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenAddDialog" Class="mb-4"
               StartIcon="@Icons.Material.Filled.Add">
        Nouvelle recette
    </MudButton>
}

<MudSimpleTable Dense="true" Hover="true" Striped="true">
    <thead>
        <tr>
            <th>Date</th>
            <th>Description</th>
            <th>Client</th>
            <th style="text-align:right">Montant</th>
            <th>Paiement</th>
            <th>Catégorie</th>
            <th>Notes</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var group in _revenuesByMonth)
        {
            <tr style="background-color: var(--mud-palette-primary); color: white; cursor: pointer;"
                @onclick="() => ToggleMonth(group.Key)">
                <td colspan="5">
                    <MudIcon Icon="@(IsExpanded(group.Key) ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                             Size="Size.Small" Style="vertical-align: middle; color: white;" />
                    <strong>@group.Label</strong> &nbsp; (@group.Revenues.Count recette(s))
                </td>
                <td style="text-align:right"><strong>@group.Total.ToString("N2") &euro;</strong></td>
                <td colspan="2"></td>
            </tr>
            @if (IsExpanded(group.Key))
            {
                @foreach (var r in group.Revenues)
                {
                    <tr>
                        <td style="white-space:nowrap">@r.Date.ToString("dd/MM/yyyy")</td>
                        <td>@r.Description</td>
                        <td>@r.Client</td>
                        <td style="text-align:right; white-space:nowrap">
                            <MudText Color="Color.Success">@r.Montant.ToString("N2") &euro;</MudText>
                        </td>
                        <td style="white-space:nowrap">@r.ModePaiement</td>
                        <td>@r.Categorie</td>
                        <td>
                            @if (_editingNoteId == r.Id)
                            {
                                <MudTextField @bind-Value="_editingNoteValue" Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Immediate="true" OnKeyDown="(e) => OnNoteKeyDown(e, r)"
                                              OnBlur="() => SaveNote(r)" Style="min-width: 150px;" />
                            }
                            else
                            {
                                <span style="cursor: pointer; color: var(--mud-palette-text-secondary); font-size: 0.85em;"
                                      @onclick="() => StartEditNote(r)">
                                    @(string.IsNullOrEmpty(r.Notes) ? "+" : r.Notes)
                                </span>
                            }
                        </td>
                        <td>
                            @if (_canEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                               OnClick="() => OpenEditDialog(r)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="() => DeleteRevenue(r)" />
                            }
                        </td>
                    </tr>
                }
            }
        }
    </tbody>
</MudSimpleTable>

<MudPaper Class="pa-4 mt-2" Elevation="1">
    <MudText Typo="Typo.h6">Total : @_total.ToString("N2") &euro;</MudText>
</MudPaper>

<MudDialog @bind-Visible="_dialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isEdit ? "Modifier la recette" : "Nouvelle recette")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudDatePicker Label="Date" @bind-Date="_editDate" Required="true" DateFormat="dd/MM/yyyy" />
            <MudTextField @bind-Value="_editItem.Description" Label="Description" Required="true" />
            <MudTextField @bind-Value="_editItem.Client" Label="Client" Required="true" />
            <MudNumericField @bind-Value="_editItem.Montant" Label="Montant (€)" Format="N2" Required="true" />
            <MudSelect @bind-Value="_editItem.ModePaiement" Label="Mode de paiement">
                <MudSelectItem Value="@("Virement")">Virement</MudSelectItem>
                <MudSelectItem Value="@("Chèque")">Chèque</MudSelectItem>
                <MudSelectItem Value="@("Espèces")">Espèces</MudSelectItem>
                <MudSelectItem Value="@("Carte bancaire")">Carte bancaire</MudSelectItem>
                <MudSelectItem Value="@("PayPal")">PayPal</MudSelectItem>
            </MudSelect>
            <MudSelect @bind-Value="_editItem.Categorie" Label="Catégorie">
                <MudSelectItem Value="ActivityCategory.BICVente">BIC Vente</MudSelectItem>
                <MudSelectItem Value="ActivityCategory.BICServices">BIC Services</MudSelectItem>
                <MudSelectItem Value="ActivityCategory.BNC">BNC (Libéral)</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="_editItem.ReferenceFacture" Label="Réf. facture (optionnel)" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _dialogVisible = false">Annuler</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveRevenue">Enregistrer</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Revenue> _revenues = new();
    private List<MonthGroup> _revenuesByMonth = new();
    private Revenue _editItem = new();
    private DateTime? _editDate = DateTime.Today;
    private bool _dialogVisible;
    private bool _isEdit;
    private MudForm? _form;
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    private DateTime? _filterDateStart = new DateTime(DateTime.Today.Year, 1, 1);
    private DateTime? _filterDateEnd = DateTime.Today;
    private string? _filterModePaiement;
    private decimal _total;
    private bool _canEdit;
    private HashSet<string> _expandedMonths = new();
    private int? _editingNoteId;
    private string _editingNoteValue = "";

    private class MonthGroup
    {
        public string Key { get; set; } = "";
        public string Label { get; set; } = "";
        public decimal Total { get; set; }
        public List<Revenue> Revenues { get; set; } = new();
    }

    private bool IsExpanded(string key) => _expandedMonths.Contains(key);
    private void ToggleMonth(string key)
    {
        if (!_expandedMonths.Remove(key)) _expandedMonths.Add(key);
    }

    protected override async Task OnInitializedAsync()
    {
        await TenantProvider.InitializeAsync();
        _canEdit = TenantProvider.CanEdit;
        await LoadData();
    }

    private async Task LoadData()
    {
        using var db = DbFactory.CreateDbContext();
        var query = db.Revenues.Where(r => r.EntityId == TenantProvider.EntityId).AsQueryable();

        if (_filterDateStart.HasValue)
            query = query.Where(r => r.Date >= _filterDateStart.Value);
        if (_filterDateEnd.HasValue)
            query = query.Where(r => r.Date <= _filterDateEnd.Value);
        if (!string.IsNullOrEmpty(_filterModePaiement))
            query = query.Where(r => r.ModePaiement == _filterModePaiement);

        _revenues = await query.OrderByDescending(r => r.Date).ToListAsync();
        _total = _revenues.Sum(r => r.Montant);

        _revenuesByMonth = _revenues
            .GroupBy(r => new { r.Date.Year, r.Date.Month })
            .OrderByDescending(g => g.Key.Year).ThenByDescending(g => g.Key.Month)
            .Select(g => new MonthGroup
            {
                Key = $"{g.Key.Year}-{g.Key.Month}",
                Label = new DateTime(g.Key.Year, g.Key.Month, 1).ToString("MMMM yyyy",
                    System.Globalization.CultureInfo.GetCultureInfo("fr-FR")),
                Total = g.Sum(r => r.Montant),
                Revenues = g.OrderByDescending(r => r.Date).ToList()
            })
            .ToList();

        if (_expandedMonths.Count == 0 && _revenuesByMonth.Any())
            _expandedMonths.Add(_revenuesByMonth.First().Key);
    }

    private async Task ApplyFilter()
    {
        _expandedMonths.Clear();
        await LoadData();
    }

    private void OpenAddDialog()
    {
        _editItem = new Revenue { Date = DateTime.Today, Categorie = ActivityCategory.BNC };
        _editDate = DateTime.Today;
        _isEdit = false;
        _dialogVisible = true;
    }

    private void OpenEditDialog(Revenue rev)
    {
        _editItem = new Revenue
        {
            Id = rev.Id, Date = rev.Date, Montant = rev.Montant,
            Description = rev.Description, Client = rev.Client,
            ModePaiement = rev.ModePaiement, Categorie = rev.Categorie,
            ReferenceFacture = rev.ReferenceFacture,
            CreatedAt = rev.CreatedAt
        };
        _editDate = rev.Date;
        _isEdit = true;
        _dialogVisible = true;
    }

    private async Task SaveRevenue()
    {
        if (!_canEdit) return;
        if (_editDate.HasValue)
            _editItem.Date = _editDate.Value;

        _editItem.UpdatedAt = DateTime.UtcNow;

        if (!_isEdit && await ClosingService.IsDateLockedAsync(TenantProvider.EntityId, _editItem.Date))
        {
            Snackbar.Add("Période clôturée", Severity.Error);
            return;
        }

        using var db = DbFactory.CreateDbContext();
        if (_isEdit)
        {
            db.Revenues.Update(_editItem);
        }
        else
        {
            _editItem.EntityId = TenantProvider.EntityId;
            _editItem.CreatedAt = DateTime.UtcNow;
            db.Revenues.Add(_editItem);
        }
        await db.SaveChangesAsync();

        if (!_isEdit)
            await HashChainService.RecordRevenueAsync(_editItem);

        _dialogVisible = false;
        Snackbar.Add(_isEdit ? "Recette modifiée" : "Recette ajoutée", Severity.Success);
        await LoadData();
    }

    private void StartEditNote(Revenue revenue)
    {
        _editingNoteId = revenue.Id;
        _editingNoteValue = revenue.Notes ?? "";
    }

    private async Task OnNoteKeyDown(KeyboardEventArgs e, Revenue revenue)
    {
        if (e.Key == "Enter") await SaveNote(revenue);
        else if (e.Key == "Escape") _editingNoteId = null;
    }

    private async Task SaveNote(Revenue revenue)
    {
        if (_editingNoteId != revenue.Id) return;
        _editingNoteId = null;

        using var db = DbFactory.CreateDbContext();
        var entity = await db.Revenues.FindAsync(revenue.Id);
        if (entity != null)
        {
            entity.Notes = string.IsNullOrWhiteSpace(_editingNoteValue) ? null : _editingNoteValue.Trim();
            entity.UpdatedAt = DateTime.UtcNow;
            await db.SaveChangesAsync();
            revenue.Notes = entity.Notes;
        }
    }

    private async Task DeleteRevenue(Revenue rev)
    {
        if (!_canEdit) return;
        if (await ClosingService.IsDateLockedAsync(TenantProvider.EntityId, rev.Date))
        {
            Snackbar.Add("Période clôturée", Severity.Error);
            return;
        }
        var result = await DialogService.ShowMessageBox(
            "Confirmation de suppression",
            $"Supprimer la recette de {rev.Montant:N2} € du {rev.Date:dd/MM/yyyy} ?",
            yesText: "Supprimer", cancelText: "Annuler");
        if (result != true) return;
        using var db = DbFactory.CreateDbContext();
        db.Revenues.Remove(rev);
        await db.SaveChangesAsync();
        Snackbar.Add("Recette supprimée", Severity.Info);
        await LoadData();
    }
}
