@page "/expenses"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject ITenantProvider TenantProvider
@inject HashChainService HashChainService
@inject ClosingService ClosingService
@inject IDialogService DialogService

<PageTitle>Dépenses — FrenchInvoice</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Dépenses</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" sm="4" md="3">
            <MudDatePicker Label="Date début" @bind-Date="_filterDateStart" DateFormat="dd/MM/yyyy"
                           Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudDatePicker Label="Date fin" @bind-Date="_filterDateEnd" DateFormat="dd/MM/yyyy"
                           Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFilter"
                       StartIcon="@Icons.Material.Filled.FilterAlt">Filtrer</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_canEdit)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenAddDialog" Class="mb-4"
               StartIcon="@Icons.Material.Filled.Add">
        Nouvelle dépense
    </MudButton>
}

<MudSimpleTable Dense="true" Hover="true" Striped="true">
    <thead>
        <tr>
            <th>Date</th>
            <th>Description</th>
            <th>Fournisseur</th>
            <th style="text-align:right">Montant</th>
            <th>Catégorie</th>
            <th>Notes</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var group in _expensesByMonth)
        {
            <tr style="background-color: var(--mud-palette-primary); color: white; cursor: pointer;"
                @onclick="() => ToggleMonth(group.Key)">
                <td colspan="3">
                    <MudIcon Icon="@(IsExpanded(group.Key) ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                             Size="Size.Small" Style="vertical-align: middle; color: white;" />
                    <strong>@group.Label</strong> &nbsp; (@group.Expenses.Count dépense(s))
                </td>
                <td style="text-align:right"><strong>@group.Total.ToString("N2") &euro;</strong></td>
                <td colspan="3"></td>
            </tr>
            @if (IsExpanded(group.Key))
            {
                @foreach (var e in group.Expenses)
                {
                    <tr>
                        <td style="white-space:nowrap">@e.Date.ToString("dd/MM/yyyy")</td>
                        <td>@e.Description</td>
                        <td>@e.Fournisseur</td>
                        <td style="text-align:right; white-space:nowrap">
                            <MudText Color="Color.Error">@e.Montant.ToString("N2") &euro;</MudText>
                        </td>
                        <td>@e.Categorie</td>
                        <td>
                            @if (_editingNoteId == e.Id)
                            {
                                <MudTextField @bind-Value="_editingNoteValue" Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Immediate="true" OnKeyDown="(args) => OnNoteKeyDown(args, e)"
                                              OnBlur="() => SaveNote(e)" Style="min-width: 150px;" />
                            }
                            else
                            {
                                <span style="cursor: pointer; color: var(--mud-palette-text-secondary); font-size: 0.85em;"
                                      @onclick="() => StartEditNote(e)">
                                    @(string.IsNullOrEmpty(e.Notes) ? "+" : e.Notes)
                                </span>
                            }
                        </td>
                        <td>
                            @if (_canEdit)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                               OnClick="() => OpenEditDialog(e)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="() => DeleteExpense(e)" />
                            }
                        </td>
                    </tr>
                }
            }
        }
    </tbody>
</MudSimpleTable>

<MudPaper Class="pa-4 mt-2" Elevation="1">
    <MudText Typo="Typo.h6">Total : @_total.ToString("N2") &euro;</MudText>
</MudPaper>

<MudDialog @bind-Visible="_dialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isEdit ? "Modifier la dépense" : "Nouvelle dépense")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudDatePicker Label="Date" @bind-Date="_editDate" Required="true" DateFormat="dd/MM/yyyy" />
            <MudTextField @bind-Value="_editItem.Description" Label="Description" Required="true" />
            <MudTextField @bind-Value="_editItem.Fournisseur" Label="Fournisseur" Required="true" />
            <MudNumericField @bind-Value="_editItem.Montant" Label="Montant (€)" Format="N2" Required="true" />
            <MudSelect @bind-Value="_editItem.Categorie" Label="Catégorie">
                <MudSelectItem Value="@("Logiciel / SaaS")">Logiciel / SaaS</MudSelectItem>
                <MudSelectItem Value="@("Matériel")">Matériel</MudSelectItem>
                <MudSelectItem Value="@("Fournitures")">Fournitures</MudSelectItem>
                <MudSelectItem Value="@("Déplacement")">Déplacement</MudSelectItem>
                <MudSelectItem Value="@("Formation")">Formation</MudSelectItem>
                <MudSelectItem Value="@("Télécommunications")">Télécommunications</MudSelectItem>
                <MudSelectItem Value="@("Autre")">Autre</MudSelectItem>
            </MudSelect>
            <MudSelect @bind-Value="_editItem.ModeReglement" Label="Mode de règlement">
                <MudSelectItem Value="@("Virement")">Virement</MudSelectItem>
                <MudSelectItem Value="@("Chèque")">Chèque</MudSelectItem>
                <MudSelectItem Value="@("Espèces")">Espèces</MudSelectItem>
                <MudSelectItem Value="@("Carte bancaire")">Carte bancaire</MudSelectItem>
                <MudSelectItem Value="@("Prélèvement")">Prélèvement</MudSelectItem>
                <MudSelectItem Value="@("PayPal")">PayPal</MudSelectItem>
            </MudSelect>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _dialogVisible = false">Annuler</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveExpense">Enregistrer</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Expense> _expenses = new();
    private List<MonthGroup> _expensesByMonth = new();
    private Expense _editItem = new();
    private DateTime? _editDate = DateTime.Today;
    private bool _dialogVisible;
    private bool _isEdit;
    private MudForm? _form;
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    private DateTime? _filterDateStart = new DateTime(DateTime.Today.Year, 1, 1);
    private DateTime? _filterDateEnd = DateTime.Today;
    private decimal _total;
    private bool _canEdit;
    private HashSet<string> _expandedMonths = new();
    private int? _editingNoteId;
    private string _editingNoteValue = "";

    private class MonthGroup
    {
        public string Key { get; set; } = "";
        public string Label { get; set; } = "";
        public decimal Total { get; set; }
        public List<Expense> Expenses { get; set; } = new();
    }

    private bool IsExpanded(string key) => _expandedMonths.Contains(key);
    private void ToggleMonth(string key)
    {
        if (!_expandedMonths.Remove(key)) _expandedMonths.Add(key);
    }

    protected override async Task OnInitializedAsync()
    {
        await TenantProvider.InitializeAsync();
        _canEdit = TenantProvider.CanEdit;
        await LoadData();
    }

    private async Task LoadData()
    {
        using var db = DbFactory.CreateDbContext();
        var query = db.Expenses.Where(e => e.EntityId == TenantProvider.EntityId).AsQueryable();

        if (_filterDateStart.HasValue)
            query = query.Where(e => e.Date >= _filterDateStart.Value);
        if (_filterDateEnd.HasValue)
            query = query.Where(e => e.Date <= _filterDateEnd.Value);

        _expenses = await query.OrderByDescending(e => e.Date).ToListAsync();
        _total = _expenses.Sum(e => e.Montant);

        _expensesByMonth = _expenses
            .GroupBy(e => new { e.Date.Year, e.Date.Month })
            .OrderByDescending(g => g.Key.Year).ThenByDescending(g => g.Key.Month)
            .Select(g => new MonthGroup
            {
                Key = $"{g.Key.Year}-{g.Key.Month}",
                Label = new DateTime(g.Key.Year, g.Key.Month, 1).ToString("MMMM yyyy",
                    System.Globalization.CultureInfo.GetCultureInfo("fr-FR")),
                Total = g.Sum(e => e.Montant),
                Expenses = g.OrderByDescending(e => e.Date).ToList()
            })
            .ToList();

        if (_expandedMonths.Count == 0 && _expensesByMonth.Any())
            _expandedMonths.Add(_expensesByMonth.First().Key);
    }

    private async Task ApplyFilter()
    {
        _expandedMonths.Clear();
        await LoadData();
    }

    private void OpenAddDialog()
    {
        _editItem = new Expense { Date = DateTime.Today };
        _editDate = DateTime.Today;
        _isEdit = false;
        _dialogVisible = true;
    }

    private void OpenEditDialog(Expense exp)
    {
        _editItem = new Expense
        {
            Id = exp.Id, Date = exp.Date, Montant = exp.Montant,
            Description = exp.Description, Fournisseur = exp.Fournisseur,
            Categorie = exp.Categorie, ModeReglement = exp.ModeReglement,
            Justificatif = exp.Justificatif,
            CreatedAt = exp.CreatedAt
        };
        _editDate = exp.Date;
        _isEdit = true;
        _dialogVisible = true;
    }

    private async Task SaveExpense()
    {
        if (!_canEdit) return;
        if (_editDate.HasValue)
            _editItem.Date = _editDate.Value;

        _editItem.UpdatedAt = DateTime.UtcNow;

        if (!_isEdit && await ClosingService.IsDateLockedAsync(TenantProvider.EntityId, _editItem.Date))
        {
            Snackbar.Add("Période clôturée", Severity.Error);
            return;
        }

        using var db = DbFactory.CreateDbContext();
        if (_isEdit)
        {
            db.Expenses.Update(_editItem);
        }
        else
        {
            _editItem.EntityId = TenantProvider.EntityId;
            _editItem.CreatedAt = DateTime.UtcNow;
            db.Expenses.Add(_editItem);
        }
        await db.SaveChangesAsync();

        if (!_isEdit)
            await HashChainService.RecordExpenseAsync(_editItem);

        _dialogVisible = false;
        Snackbar.Add(_isEdit ? "Dépense modifiée" : "Dépense ajoutée", Severity.Success);
        await LoadData();
    }

    private void StartEditNote(Expense expense)
    {
        _editingNoteId = expense.Id;
        _editingNoteValue = expense.Notes ?? "";
    }

    private async Task OnNoteKeyDown(KeyboardEventArgs e, Expense expense)
    {
        if (e.Key == "Enter") await SaveNote(expense);
        else if (e.Key == "Escape") _editingNoteId = null;
    }

    private async Task SaveNote(Expense expense)
    {
        if (_editingNoteId != expense.Id) return;
        _editingNoteId = null;

        using var db = DbFactory.CreateDbContext();
        var entity = await db.Expenses.FindAsync(expense.Id);
        if (entity != null)
        {
            entity.Notes = string.IsNullOrWhiteSpace(_editingNoteValue) ? null : _editingNoteValue.Trim();
            entity.UpdatedAt = DateTime.UtcNow;
            await db.SaveChangesAsync();
            expense.Notes = entity.Notes;
        }
    }

    private async Task DeleteExpense(Expense exp)
    {
        if (!_canEdit) return;
        if (await ClosingService.IsDateLockedAsync(TenantProvider.EntityId, exp.Date))
        {
            Snackbar.Add("Période clôturée", Severity.Error);
            return;
        }
        var result = await DialogService.ShowMessageBox(
            "Confirmation de suppression",
            $"Supprimer la dépense de {exp.Montant:N2} € du {exp.Date:dd/MM/yyyy} ?",
            yesText: "Supprimer", cancelText: "Annuler");
        if (result != true) return;
        using var db = DbFactory.CreateDbContext();
        db.Expenses.Remove(exp);
        await db.SaveChangesAsync();
        Snackbar.Add("Dépense supprimée", Severity.Info);
        await LoadData();
    }
}
